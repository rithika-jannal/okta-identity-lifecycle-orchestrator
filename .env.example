# Copy this file as-is. Replace placeholder Okta values with your tenant.
# Spring Boot and Vite both load this file from the repo root.

# --- Backend ---
SERVER_PORT=8080
API_CONTEXT_PATH=/api

# --- MySQL (matches docker-compose.yml) ---
DB_URL=jdbc:mysql://localhost:3306/identity_orchestrator
DB_USERNAME=root
DB_PASSWORD=root

# --- Okta Management API ---
# Use the tenant host only, e.g. https://dev-123456.okta.com
# Do not append /oauth2/default (that is for OIDC, not the Management API).
OKTA_DOMAIN=https://trial-3149343.okta.com
OKTA_API_TOKEN="00wGM76_XkLARyhj2aZS9HzBYdtGP6eeSY3LR7K-Ac"
OKTA_CLIENT_ID=replace-me
OKTA_CLIENT_SECRET=replace-me

# --- CORS (React Vite dev server) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Frontend (Vite only exposes VITE_* to the browser) ---
VITE_API_BASE_URL=http://localhost:8080/api
